HOST=127.0.0.1
PORT=3010

# Infrastructure admin bootstrap/recovery credentials. On the first successful
# central-admin login after the shared identity deployment, this account is also
# established as the Games Platform administrator and receives game-admin roles.
# Keep this hash server-side; do not copy it into game .env files.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$REPLACE_WITH_SALT$REPLACE_WITH_HASH

DEPLOY_GITHUB_REPO=https://github.com/gh50/games-portal
DEPLOY_GITHUB_BRANCH=main
DEPLOY_GITHUB_TOKEN=
