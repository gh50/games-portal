# Central infrastructure admin bootstrap/recovery credentials.
# Keep this hash server-side; do not copy it into game .env files.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$REPLACE_WITH_SALT$REPLACE_WITH_HASH

# GitHub deployment source.
DEPLOY_GITHUB_REPO=https://github.com/gh50/games-portal
DEPLOY_GITHUB_BRANCH=main
DEPLOY_GITHUB_TOKEN=
